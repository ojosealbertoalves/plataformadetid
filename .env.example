# Banco de dados — PostgreSQL (dev e produção usam o mesmo provider).
#
# Local (dev): aponte para o Postgres do docker-compose.yml incluso
# (`docker compose up -d`), que sobe usuário/senha/db "tid"/"tid"/"plataforma_tid":
DATABASE_URL="postgresql://tid:tid@localhost:5432/plataforma_tid?schema=public"
#
# Produção (Railway): não defina manualmente — adicione o plugin PostgreSQL do
# Railway ao projeto e referencie a variável que ele injeta automaticamente
# (normalmente ${{Postgres.DATABASE_URL}} nas variáveis do serviço da app).

# Auth.js (NextAuth) — chave usada para assinar sessões/JWT.
# Obrigatório em produção. Gere um valor aleatório com:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL pública onde a aplicação roda.
# Dev: http://localhost:3000
# Produção (Railway): a URL pública do serviço, ex.: https://<app>.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# Assistente IA (OpenRouter). Deixe vazio para manter a aba desabilitada.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
